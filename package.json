{
  "name": "hanyang-dosirak",
  "productName": "한양도시락",
  "description": "한양도시락 매장 키오스크 및 관리 시스템",
  "version": "1.0.17",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "tsx server.ts",
    "start": "tsx server.ts",
    "build": "vite build",
    "build:server": "node scripts/build-server.js",
    "build:all": "npm run build && npm run build:server",
    "build:apk": "bash scripts/build-apk.sh",
    "cap:sync": "npm run build && npx cap sync",
    "cap:open": "npx cap open android",
    "electron:dev": "cross-env NODE_ENV=development electron electron/main.cjs",
    "electron:build": "npm run build:all && electron-builder --win --x64",
    "electron:build:portable": "npm run build:all && electron-builder --win portable --x64",
    "electron:build:dir": "npm run build:all && electron-builder --dir",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist",
    "preview": "tsx server.ts",
    "clean": "rm -rf dist dist-server dist-electron",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@capacitor/android": "8.6.0",
    "@capacitor/cli": "8.6.0",
    "@capacitor/core": "8.6.0",
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@types/d3": "^7.4.3",
    "@vitejs/plugin-react": "^5.0.4",
    "d3": "^7.9.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "tsx": "^4.21.0",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "concurrently": "^10.0.7",
    "cross-env": "^10.1.0",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.25.0",
    "gh-pages": "^6.3.0",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "wait-on": "^9.5.1"
  },
  "build": {
    "appId": "com.hanyang.dosirak.desktop",
    "productName": "한양도시락",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**/*",
      "dist-server/**/*",
      "electron/**/*",
      "public/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "dir",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/pwa-512x512.png"
    }
  }
}
